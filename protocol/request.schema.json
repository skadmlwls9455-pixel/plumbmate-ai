{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plumbmate/request.schema.json",
  "title": "PlumbMate turn request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "kind",
    "created_at",
    "player_message",
    "session_id",
    "actor"
  ],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 80},
    "kind": {"const": "turn"},
    "created_at": {"type": "string"},
    "player_message": {"type": "string", "maxLength": 1000},
    "session_id": {"type": "string", "maxLength": 80},
    "game": {
      "type": "object",
      "additionalProperties": true
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sim_id", "name"],
      "properties": {
        "sim_id": {"type": ["integer", "string"]},
        "name": {"type": "string", "maxLength": 120},
        "age": {"type": "string", "maxLength": 40},
        "gender": {"type": "string", "maxLength": 40},
        "mood": {"type": "string", "maxLength": 80}
      }
    },
    "household": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sim_id", "name"],
        "properties": {
          "sim_id": {"type": ["integer", "string"]},
          "name": {"type": "string", "maxLength": 120}
        }
      }
    },
    "state_delta": {"type": "object", "additionalProperties": true},
    "recent_events": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 240}
    },
    "memory_summary": {"type": "string", "maxLength": 1600}
  }
}

